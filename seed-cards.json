    { "id": "p11", "category": "phrases", "spanish": "Aqu\u00ed est\u00e1 su recibo.", "english": "Here is your receipt.", "notes": "", "pronunciationHint": "", "acceptableAnswers": [], "isBuiltIn": true, "isEnabled": true, "timesSeen": 0, "timesCorrect": 0 },
