    { "id": "p3", "category": "phrases", "spanish": "\u00bfCu\u00e1l es su nombre?", "english": "What is your name?", "notes": "", "pronunciationHint": "", "acceptableAnswers": [], "isBuiltIn": true, "isEnabled": true, "timesSeen": 0, "timesCorrect": 0 },
    { "id": "p4", "category": "phrases", "spanish": "\u00bfMe da las llaves, por favor?", "english": "Can you give me the keys, please?", "notes": "", "pronunciationHint": "", "acceptableAnswers": [], "isBuiltIn": true, "isEnabled": true, "timesSeen": 0, "timesCorrect": 0 },
    { "id": "p5", "category": "phrases", "spanish": "Puede esperar en la sala de espera.", "english": "You can wait in the waiting room.", "notes": "", "pronunciationHint": "", "acceptableAnswers": [], "isBuiltIn": true, "isEnabled": true, "timesSeen": 0, "timesCorrect": 0 },
