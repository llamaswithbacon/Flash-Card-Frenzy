    { "id": "p25", "category": "phrases", "spanish": "Tenemos tres tipos de aceite: convencional, semisint\u00e9tico y sint\u00e9tico completo. Son como bueno, mejor y lo mejor.", "english": "We have three grades of oil: conventional, semi-synthetic, and full synthetic. Think of them as good, better, and best.", "notes": "", "pronunciationHint": "", "acceptableAnswers": [], "isBuiltIn": true, "isEnabled": true, "timesSeen": 0, "timesCorrect": 0 },
