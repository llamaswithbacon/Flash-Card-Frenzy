    { "id": "p1", "category": "phrases", "spanish": "Bienvenido. \u00bfEn qu\u00e9 le puedo ayudar?", "english": "Welcome. How can I help you?", "notes": "", "pronunciationHint": "", "acceptableAnswers": [], "isBuiltIn": true, "isEnabled": true, "timesSeen": 0, "timesCorrect": 0 },
