    { "id": "p19", "category": "phrases", "spanish": "Voy a buscarlo cuando est\u00e9 listo.", "english": "I'll get you when it's ready.", "notes": "Uses the formal \"lo\" (usted). Use \"la\" instead when addressing a woman customer by name.", "pronunciationHint": "", "acceptableAnswers": ["Voy a buscarla cuando est\u00e9 listo."], "isBuiltIn": true, "isEnabled": true, "timesSeen": 0, "timesCorrect": 0 },
    { "id": "p20", "category": "phrases", "spanish": "\u00bfPrefiere que lo llamemos o le mandemos un mensaje?", "english": "Would you like a call or a text?", "notes": "", "pronunciationHint": "", "acceptableAnswers": [], "isBuiltIn": true, "isEnabled": true, "timesSeen": 0, "timesCorrect": 0 },
