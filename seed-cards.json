    { "id": "p16", "category": "phrases", "spanish": "\u00bfQu\u00e9 problema tiene el carro?", "english": "What's wrong with the car?", "notes": "", "pronunciationHint": "", "acceptableAnswers": [], "isBuiltIn": true, "isEnabled": true, "timesSeen": 0, "timesCorrect": 0 },
